# YouTube Data API v3のAPIキー
# https://console.cloud.google.com/ から取得してください
YOUTUBE_API_KEY=your_api_key_here

# 統計情報を取得したいYouTubeチャンネルID
# チャンネルページのURLから確認できます（例: https://www.youtube.com/channel/UCxxxxxxxxxxxxxx）
YOUTUBE_CHANNEL_ID=your_channel_id_here

# 出力するCSVファイル名（オプション）
OUTPUT_FILE=youtube_stats.csv
